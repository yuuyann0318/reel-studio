{
  "backend": "mock",
  "claude_bin": "/Users/yuuya/.local/bin/claude",
  "claude_model": "claude-opus-4-8",
  "claude_timeout_sec": 600,
  "resolution": [
    1080,
    1920
  ],
  "aspect": "9:16",
  "target_duration_sec": 30,
  "voice": "Kyoko",
  "default_subtitle_style": "default",
  "director_quality": "supreme",
  "brand_rules": {
    "ng_words": [
      "絶対稼げる",
      "絶対に稼げる",
      "100%成功",
      "100%儲かる",
      "元本保証",
      "必ず儲かる",
      "みお",
      "@mio_ai_insta_"
    ]
  },
  "higgsfield": {
    "cli_bin": "higgsfield",
    "model": "seedance_2_0_mini",
    "resolution": "480p",
    "max_credits_per_shot": 10,
    "poll_interval_sec": 5,
    "poll_timeout_sec": 600
  },
  "cloudapi": {
    "base_url": "https://api.higgsfield.example/v1",
    "api_key_env": "HIGGSFIELD_API_KEY"
  },
  "tts": {
    "engine": "fish_audio",
    "fish_audio": {
      "api_key_env": "FISH_AUDIO_API_KEY",
      "model": "s2.1-pro-free",
      "reference_id": "0089dce5fefb4c6ba9b9f2f0debe1ddc",
      "format": "wav",
      "timeout_sec": 60,
      "prosody_speed": 1.15
    }
  },
  "product_images": {
    "max_images": 6,
    "min_short_side": 400,
    "local_dir": "assets/products/inbox",
    "timeout_sec": 20
  },
  "reference": {
    "cache_dir": "assets/reference_cache",
    "yt_dlp_bin": ".venv/bin/yt-dlp",
    "download_timeout_sec": 120,
    "asr_timeout_sec": 120,
    "max_video_sec": 180
  }
}
